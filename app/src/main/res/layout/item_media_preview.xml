<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_md"> <ImageView
    android:id="@+id/preview_image_view"
    android:layout_width="100dp" android:layout_height="100dp"
    android:scaleType="centerCrop"
    android:contentDescription="Media Preview"
    tools:src="@tools:sample/avatars" />

    <ImageButton
        android:id="@+id/button_remove_media"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/ic_remove_circle_background" android:src="@drawable/ic_close"
        app:tint="@color/white"
        android:scaleType="centerInside"
        android:padding="4dp"
        android:contentDescription="Remove Media" />

</FrameLayout>