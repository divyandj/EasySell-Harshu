<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_md"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="4dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Enhanced product image with creative overlay and better visual hierarchy -->
        <FrameLayout
            android:id="@+id/image_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/product_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Product Image"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Gradient overlay for better badge visibility -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/image_overlay_gradient" />

            <!-- Quick action overlay on hover -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#80000000"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Details"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_visibility"
                    app:iconTint="@android:color/white" />
            </LinearLayout>
        </FrameLayout>

        <!-- Enhanced sale badge with creative styling -->
        <com.google.android.material.chip.Chip
            android:id="@+id/sale_badge_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="SALE"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold"
            android:visibility="gone"
            app:chipBackgroundColor="@color/error"
            app:chipCornerRadius="@dimen/radius_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- Enhanced visibility badge with better visual design -->
        <com.google.android.material.chip.Chip
            android:id="@+id/visibility_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="Visible"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold"
            android:visibility="gone"
            app:chipBackgroundColor="@color/visible"
            app:chipCornerRadius="@dimen/radius_md"
            app:chipIcon="@drawable/ic_visibility"
            app:chipIconTint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- Enhanced product details section with improved spacing and typography -->
        <LinearLayout
            android:id="@+id/details_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            app:layout_constraintTop_toBottomOf="@id/image_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Product name with enhanced typography -->
            <TextView
                android:id="@+id/product_name_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textAppearance="@style/TextHeadline2"
                android:textSize="@dimen/text_base"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="@dimen/spacing_sm"
                tools:text="Elegant Summer Floral Print Dress" />

            <!-- Enhanced pricing section with better visual hierarchy and accent color -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    android:id="@+id/product_price_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextHeadline2"
                    android:textSize="@dimen/text_lg"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    tools:text="₹1,299" />

                <TextView
                    android:id="@+id/product_original_price_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:textAppearance="@style/TextCaption"
                    android:textColor="@color/gray_400"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="₹2,499" />
            </LinearLayout>

            <!-- Enhanced stock status indicator with creative dot design -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_lg">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/stock_indicator_dot"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <TextView
                    android:id="@+id/stock_status_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextCaption"
                    android:textColor="@color/gray_500"
                    tools:text="12 in stock" />
            </LinearLayout>

            <!-- Enhanced action buttons with better visual design and spacing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:spacing="@dimen/spacing_sm">

                <!-- Visibility toggle button with improved styling -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/product_visibility_toggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="Hide"
                    android:textSize="@dimen/text_xs"
                    android:paddingVertical="@dimen/spacing_sm"
                    app:icon="@drawable/ic_visibility_off"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/radius_md"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp" />

                <!-- Edit button with primary color -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_edit_product"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit"
                    android:textSize="@dimen/text_xs"
                    android:paddingVertical="@dimen/spacing_sm"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/radius_md" />

                <!-- Delete button with error color (Icon-only) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_delete_product"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/error"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/radius_md"
                    app:strokeColor="@color/error"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
