<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Order Details"
            app:titleTextAppearance="@style/TextHeadline2"
            app:navigationIcon="@drawable/ic_arrow_back"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <androidx.cardview.widget.CardView
                style="@style/CardElevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_order_id"
                                style="@style/TextHeadline1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="#ORD-12345678"/>

                            <TextView
                                android:id="@+id/text_order_date"
                                style="@style/TextBody2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Oct 26, 2025 • 10:30 AM"
                                android:layout_marginTop="@dimen/spacing_xs"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/status_badge"
                            style="@style/EasySellStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Pending"
                            tools:background="@drawable/bg_chip_blue"
                            tools:textColor="@color/info"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/CardElevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/TextHeadline3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update Status"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_gray">

                            <Spinner
                                android:id="@+id/spinner_status"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:popupBackground="@color/white"
                                android:gravity="center_vertical"/>

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_arrow_drop_down"
                                android:layout_gravity="center_vertical|end"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                app:tint="@color/text_secondary"/>
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_update_status"
                            style="@style/ButtonPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:text="Update"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_invoice"
                style="@style/ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="Download &amp; Share Invoice"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/primary"
                app:iconGravity="textStart"/>

            <TextView
                style="@style/DetailSectionHeader"
                android:text="Items Ordered"
                android:layout_marginStart="@dimen/spacing_xs"/>

            <androidx.cardview.widget.CardView
                style="@style/CardElevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_order_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_sm"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_order_product"/>
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/DetailSectionHeader"
                android:text="Customer Details"
                android:layout_marginStart="@dimen/spacing_xs"/>

            <androidx.cardview.widget.CardView
                style="@style/CardElevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_md">
                        <ImageView
                            android:layout_width="@dimen/icon_xs"
                            android:layout_height="@dimen/icon_xs"
                            android:src="@drawable/ic_person"
                            app:tint="@color/text_tertiary"
                            android:layout_marginTop="3dp"/>
                        <TextView
                            android:id="@+id/text_customer_name"
                            style="@style/TextBody1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            tools:text="Dhara Mehta"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_md">
                        <ImageView
                            android:layout_width="@dimen/icon_xs"
                            android:layout_height="@dimen/icon_xs"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/text_tertiary"
                            android:layout_marginTop="3dp"/>
                        <TextView
                            android:id="@+id/text_customer_phone"
                            style="@style/TextBody1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            tools:text="+91 7208681111"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="@dimen/icon_xs"
                            android:layout_height="@dimen/icon_xs"
                            android:src="@drawable/ic_location_on"
                            app:tint="@color/text_tertiary"
                            android:layout_marginTop="3dp"/>
                        <TextView
                            android:id="@+id/text_shipping_address"
                            style="@style/TextBody1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            tools:text="1203, Imperial Heights, Goregaon West, Mumbai - 400104"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_transport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:visibility="gone"
                        tools:visibility="visible">
                        <ImageView
                            android:layout_width="@dimen/icon_xs"
                            android:layout_height="@dimen/icon_xs"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/text_tertiary"
                            android:layout_marginTop="3dp"
                            android:rotation="-90"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:text="Preferred Transport: "
                            style="@style/TextBody2"/>
                        <TextView
                            android:id="@+id/text_transport_name"
                            style="@style/TextHeadline3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="VRL Logistics"
                            android:textColor="@color/primary"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/DetailSectionHeader"
                android:text="Payment Summary"
                android:layout_marginStart="@dimen/spacing_xs"/>

            <androidx.cardview.widget.CardView
                style="@style/CardElevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/text_billing_type"
                        style="@style/TextCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GST Invoice"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_chip_gray"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:layout_gravity="end"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_sm">
                        <TextView
                            style="@style/TextBody2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"/>
                        <TextView
                            android:id="@+id/text_subtotal"
                            style="@style/TextBody1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="₹40,000"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_tax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:visibility="gone"
                        tools:visibility="visible">
                        <TextView
                            style="@style/TextBody2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tax (GST 18%)"/>
                        <TextView
                            android:id="@+id/text_tax"
                            style="@style/TextBody1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/error"
                            tools:text="+ ₹7,200"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginVertical="@dimen/spacing_sm"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/TextHeadline3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Amount"/>
                        <TextView
                            android:id="@+id/text_total_amount"
                            style="@style/TextHeadline1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="₹47,200"
                            android:textColor="@color/primary"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>